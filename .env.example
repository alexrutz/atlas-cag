# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# --- llama-server -------------------------------------------------------------------
# Managed mode (recommended): Atlas runs llama-server itself from the presets you create in
# Settings. Point this at the binary; source builds work as is (their lib dir is added to
# LD_LIBRARY_PATH automatically).
ATLAS_LLAMA_SERVER_BIN=~/llama.cpp/build/bin/llama-server
ATLAS_LLAMA_PORT=8081
# Seconds to wait for a model to load before a preset counts as failed.
ATLAS_LLAMA_START_TIMEOUT_S=900

# Keep the standard build up to date from GitHub releases (ai-dock/llama.cpp-cuda):
# off | install (use from the next llama-server start) | apply (also restart when idle).
ATLAS_BUILD_UPDATES=install
# ATLAS_BUILD_UPDATE_REPO=ai-dock/llama.cpp-cuda
# ATLAS_BUILD_UPDATE_ASSET=cuda-12.8-amd64
# ATLAS_BUILD_UPDATE_INTERVAL_H=6

# External mode: leave ATLAS_LLAMA_SERVER_BIN empty and connect to a llama-server you run yourself
# (e.g. scripts/run-llama-server.sh). ATLAS_KV_DIR must then equal its --slot-save-path.
# ATLAS_LLAMA_URL=http://127.0.0.1:8080
# ATLAS_LLAMA_API_KEY=

# --- storage --------------------------------------------------------------------------
ATLAS_DATA_DIR=./data
# KV cache slot files: put them on fast local NVMe.
ATLAS_KV_DIR=./data/kv

# --- models ---------------------------------------------------------------------------
# Comma-separated directories scanned for .gguf files; downloads from the UI go into the first.
ATLAS_MODELS_DIRS=./data/models
# Also list GGUFs from the Hugging Face cache and llama.cpp's -hf download cache.
ATLAS_SCAN_MODEL_CACHES=true
# Token for gated or private Hugging Face repositories (or run `hf auth login`).
# HF_TOKEN=

# --- server ---------------------------------------------------------------------------
# 0.0.0.0 makes Atlas reachable from other machines (set ATLAS_API_KEYS then).
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
# Comma-separated bearer tokens; empty disables authentication.
ATLAS_API_KEYS=
ATLAS_MAX_UPLOAD_MB=200

# --- defaults for Settings → Generation ----------------------------------------------
# Values saved in the UI override these.
ATLAS_MAX_QUESTION_TOKENS=1024
ATLAS_MAX_ANSWER_TOKENS=1024
ATLAS_MAX_FINAL_TOKENS=2048
ATLAS_TEMPERATURE=0.2
ATLAS_TOP_P=0.95
ATLAS_ENABLE_THINKING=false
ATLAS_MAX_THINKING_TOKENS=2048
# Off: every per-document answer goes into the synthesis (best recall in testing).
# On: answers self-rate their coverage and "none" answers are dropped: faster over many
# documents, but trusts the model's rating.
ATLAS_RELEVANCE_FILTER=false
ATLAS_INGEST_CONCURRENCY=1
ATLAS_PART_OVERLAP_TOKENS=256
ATLAS_AUTO_BUILD_CACHES=true
# Rewrite follow-up questions into standalone questions using the conversation.
ATLAS_CONDENSE_FOLLOWUPS=true
# New PDFs and images: "text" (extracted text) or "visual" (page images; needs a preset with a
# vision projector). Page resolution for visual prefill:
ATLAS_DEFAULT_PREFILL=text
ATLAS_VISUAL_DPI=120
# ATLAS_SYSTEM_PROMPT="..."     # changing it creates a new cache configuration
# ATLAS_SYNTHESIS_PROMPT="..."
